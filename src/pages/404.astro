---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { url } from '../data/site.js';
---
<Base title="Page not found" cta={false}>
  <PageHero title="This page isn't here." lead="The link may be old or mistyped. Head back home, or tell us what you were looking for.">
    <a class="btn" href={url('/')}>Go to the home page</a>
    <a class="link" href={url('/contact')}>Contact us</a>
  </PageHero>
</Base>
